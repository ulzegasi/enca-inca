Cell[BoxData[{
 RowBox[{
  RowBox[{
   RowBox[{"paramsNoSigma", "=", 
    RowBox[{"{", 
     RowBox[{"\"\<\[Tau]\>\"", ",", "\"\<T\>\"", ",", "\"\<Nd\>\"", 
