  RowBox[{"rmseRef", "=", 
   RowBox[{"Max", "[", "meanRMSE", "]"}]}], ";"}], "\[IndentingNewLine]", 
 RowBox[{
  RowBox[{"reconPerf", "=", 
   RowBox[{"1", "-", 
