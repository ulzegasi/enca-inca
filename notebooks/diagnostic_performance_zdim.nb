        RowBox[{"{", "}"}]}], "]"}]}], ";", "\n", "  ", 
     RowBox[{"plotStyles", " ", "=", " ", 
      RowBox[{"Take", "[", "\n", "    ", 
       RowBox[{
        RowBox[{"{", 
         RowBox[{"Blue", ",", " ", 
          RowBox[{"Darker", "[", "Red", "]"}], ",", " ", 
          RowBox[{"Directive", "[", 
           RowBox[{"Blue", ",", " ", "Dashed"}], "]"}], ",", " ", 
          RowBox[{"Directive", "[", 
           RowBox[{
            RowBox[{"Darker", "[", "Red", "]"}], ",", " ", "Dashed"}], 
           "]"}]}], "}"}], ",", "\n", "    ", 
        RowBox[{"Length", "[", "plotData", "]"}]}], "\n", "  ", "]"}]}], ";", 
     "\n", "  ", 
     RowBox[{"plotMarkers", " ", "=", " ", 
      RowBox[{"Take", "[", "\n", "    ", 
       RowBox[{
        RowBox[{"{", 
         RowBox[{
          RowBox[{"{", 
           RowBox[{"\"\<\[FilledCircle]\>\"", ",", " ", "16"}], "}"}], ",", 
          " ", 
          RowBox[{"{", 
           RowBox[{"\"\<\[FilledSquare]\>\"", ",", " ", "16"}], "}"}], ",", 
          " ", 
          RowBox[{"{", 
