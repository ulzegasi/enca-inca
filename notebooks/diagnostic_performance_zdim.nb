Cell[BoxData[{
 RowBox[{
  RowBox[{
   RowBox[{"corrCPU", "[", "param_", "]"}], " ", ":=", " ", 
   RowBox[{
    RowBox[{"paramDataCPU", "[", "param", "]"}], "[", 
    RowBox[{"[", 
     RowBox[{"All", ",", " ", "1"}], "]"}], "]"}]}], ";"}], "\n", 
 RowBox[{
  RowBox[{
   RowBox[{
    RowBox[{"perfCPU", "[", "param_", "]"}], " ", ":=", " ", 
    RowBox[{"1", " ", "-", " ", 
     RowBox[{"(", 
      RowBox[{
       RowBox[{"(", 
        RowBox[{
         RowBox[{
          RowBox[{"paramDataCPU", "[", "param", "]"}], "[", 
          RowBox[{"[", 
           RowBox[{"All", ",", " ", "2"}], "]"}], "]"}], "/", "100"}], ")"}], 
       "/", "baselineError"}], ")"}]}]}], ";"}], "\n"}], "\n", 
 RowBox[{
  RowBox[{
   RowBox[{
    RowBox[{"cpuSeriesFor", "[", 
     RowBox[{"corrVals_", ",", " ", "perfVals_"}], "]"}], " ", ":=", " ", 
    RowBox[{"Module", "[", 
     RowBox[{
      RowBox[{"{", "param", "}"}], ",", "\n", "  ", 
      RowBox[{
       RowBox[{"param", " ", "=", " ", 
        RowBox[{"SelectFirst", "[", "\n", "    ", 
         RowBox[{
          RowBox[{"Keys", "[", "paramData", "]"}], ",", "\n", "    ", 
          RowBox[{
           RowBox[{
            RowBox[{
             RowBox[{"corr", "[", "#", "]"}], " ", "===", " ", "corrVals"}], 
            " ", "&&", " ", 
            RowBox[{
             RowBox[{"perf", "[", "#", "]"}], " ", "===", " ", "perfVals"}]}],
            " ", "&"}], ",", "\n", "    ", "None"}], "\n", "  ", "]"}]}], ";",
        "\n", "  ", 
       RowBox[{"If", "[", 
        RowBox[{
         RowBox[{"param", " ", "=!=", " ", "None"}], ",", "\n", "    ", 
         RowBox[{"{", 
          RowBox[{
           RowBox[{"corrCPU", "[", "param", "]"}], ",", " ", 
           RowBox[{"perfCPU", "[", "param", "]"}]}], "}"}], ",", "\n", "    ", 
         RowBox[{"If", "[", "\n", "      ", 
          RowBox[{
           RowBox[{
            RowBox[{"ValueQ", "[", "paramsNoSigma", "]"}], " ", "&&", " ", 
            RowBox[{"corrVals", " ", "===", " ", "meanCorrNoSigma"}], " ", "&&",
             "\n", "        ", 
            RowBox[{"perfVals", " ", "===", " ", "meanPerfNoSigma"}]}], ",", 
           "\n", "      ", 
           RowBox[{"{", "\n", "        ", 
            RowBox[{
             RowBox[{"Mean", " ", "/@", " ", 
              RowBox[{"Transpose", "[", 
               RowBox[{"corrCPU", " ", "/@", " ", "paramsNoSigma"}], "]"}]}], 
             ",", "\n", "        ", 
             RowBox[{"Mean", " ", "/@", " ", 
              RowBox[{"Transpose", "[", 
               RowBox[{"perfCPU", " ", "/@", " ", "paramsNoSigma"}], 
               "]"}]}]}], "\n", "      ", "}"}], ",", "\n", "      ", 
           RowBox[{"{", 
            RowBox[{
             RowBox[{"{", "}"}], ",", " ", 
             RowBox[{"{", "}"}]}], "}"}]}], "\n", "    ", "]"}]}], "\n", "  ",
         "]"}]}]}], "\n", "]"}]}], ";"}], "\n"}], "\n", 
 RowBox[{
  RowBox[{"dualAxisPlot", "[", 
   RowBox[{"title_", ",", " ", "corrVals_", ",", " ", "perfVals_"}], "]"}], 
  " ", ":=", " ", 
  RowBox[{"Module", "[", "\n", "  ", 
   RowBox[{
    RowBox[{"{", 
     RowBox[{
     "perfData", ",", " ", "corrData", ",", " ", "cpuCorrVals", ",", " ", 
      "cpuPerfVals", ",", " ", "perfDataCPU", ",", " ", "corrDataCPU", ",", 
      "\n", "   ", "plotData", ",", " ", "plotStyles", ",", " ", 
      "plotMarkers", ",", " ", "plotLegends", ",", " ", "allZDims"}], "}"}], ",",
     "\n", "  ", 
    RowBox[{
     RowBox[{"perfData", " ", "=", " ", 
      RowBox[{"Transpose", "[", 
       RowBox[{"{", 
        RowBox[{"zDims", ",", " ", "perfVals"}], "}"}], "]"}]}], ";", "\n", 
     "  ", 
     RowBox[{"corrData", " ", "=", " ", 
      RowBox[{"Transpose", "[", 
       RowBox[{"{", 
        RowBox[{"zDims", ",", " ", "corrVals"}], "}"}], "]"}]}], ";", "\n", 
     "  ", 
     RowBox[{
      RowBox[{"{", 
       RowBox[{"cpuCorrVals", ",", " ", "cpuPerfVals"}], "}"}], " ", "=", " ", 
      RowBox[{"cpuSeriesFor", "[", 
       RowBox[{"corrVals", ",", " ", "perfVals"}], "]"}]}], ";", "\n", "  ", 
     RowBox[{"perfDataCPU", " ", "=", " ", 
      RowBox[{"If", "[", 
       RowBox[{
        RowBox[{"cpuPerfVals", " ", "===", " ", 
         RowBox[{"{", "}"}]}], ",", " ", 
        RowBox[{"{", "}"}], ",", " ", 
        RowBox[{"Transpose", "[", 
         RowBox[{"{", 
          RowBox[{"zDimsCPU", ",", " ", "cpuPerfVals"}], "}"}], "]"}]}], 
       "]"}]}], ";", "\n", "  ", 
     RowBox[{"corrDataCPU", " ", "=", " ", 
      RowBox[{"If", "[", 
       RowBox[{
        RowBox[{"cpuCorrVals", " ", "===", " ", 
         RowBox[{"{", "}"}]}], ",", " ", 
        RowBox[{"{", "}"}], ",", " ", 
        RowBox[{"Transpose", "[", 
         RowBox[{"{", 
          RowBox[{"zDimsCPU", ",", " ", "cpuCorrVals"}], "}"}], "]"}]}], 
       "]"}]}], ";", "\n", "  ", 
     RowBox[{"plotData", " ", "=", " ", 
      RowBox[{"DeleteCases", "[", 
       RowBox[{
        RowBox[{"{", 
         RowBox[{
         "perfData", ",", " ", "corrData", ",", " ", "perfDataCPU", ",", " ", 
          "corrDataCPU"}], "}"}], ",", " ", 
        RowBox[{"{", "}"}]}], "]"}]}], ";", "\n", "  ", 
     RowBox[{"plotStyles", " ", "=", " ", 
      RowBox[{"Take", "[", "\n", "    ", 
       RowBox[{
        RowBox[{"{", 
         RowBox[{"Blue", ",", " ", 
          RowBox[{"Darker", "[", "Red", "]"}], ",", " ", 
          RowBox[{"Directive", "[", 
           RowBox[{"Blue", ",", " ", "Dashed"}], "]"}], ",", " ", 
          RowBox[{"Directive", "[", 
           RowBox[{
            RowBox[{"Darker", "[", "Red", "]"}], ",", " ", "Dashed"}], 
           "]"}]}], "}"}], ",", "\n", "    ", 
        RowBox[{"Length", "[", "plotData", "]"}]}], "\n", "  ", "]"}]}], ";", 
     "\n", "  ", 
     RowBox[{"plotMarkers", " ", "=", " ", 
      RowBox[{"Take", "[", "\n", "    ", 
       RowBox[{
        RowBox[{"{", 
         RowBox[{
          RowBox[{"{", 
           RowBox[{"\"\<\[FilledCircle]\>\"", ",", " ", "16"}], "}"}], ",", 
          " ", 
          RowBox[{"{", 
           RowBox[{"\"\<\[FilledSquare]\>\"", ",", " ", "16"}], "}"}], ",", 
          " ", 
          RowBox[{"{", 
           RowBox[{"\"\<\[EmptyCircle]\>\"", ",", " ", "16"}], "}"}], ",", 
          "\n", "     ", 
          RowBox[{"{", 
           RowBox[{"\"\<\[EmptySquare]\>\"", ",", " ", "16"}], "}"}]}], "}"}],
         ",", "\n", "    ", 
        RowBox[{"Length", "[", "plotData", "]"}]}], "\n", "  ", "]"}]}], ";", 
     "\n", "  ", 
     RowBox[{"plotLegends", " ", "=", " ", 
      RowBox[{"Take", "[", "\n", "    ", 
       RowBox[{
        RowBox[{"{", 
         RowBox[{"\"\<1 - (mean) normalized RMSE\>\"", ",", 
          " ", "\"\<mean corr\>\"", ",", "\n", 
          "     ", "\"\<CPU 1 - (mean) normalized RMSE\>\"", ",", 
          " ", "\"\<CPU mean corr\>\""}], "}"}], ",", "\n", "    ", 
        RowBox[{"Length", "[", "plotData", "]"}]}], "\n", "  ", "]"}]}], ";", 
     "\n", "  ", 
     RowBox[{"allZDims", " ", "=", " ", 
      RowBox[{"Sort", "[", 
       RowBox[{"Union", "[", 
        RowBox[{"zDims", ",", " ", 
         RowBox[{"If", "[", 
          RowBox[{
           RowBox[{"cpuCorrVals", " ", "===", " ", 
            RowBox[{"{", "}"}]}], ",", " ", 
           RowBox[{"{", "}"}], ",", " ", "zDimsCPU"}], "]"}]}], "]"}], 
       "]"}]}], ";", "\n", "  ", 
     RowBox[{"ListLinePlot", "[", "\n", "    ", 
      RowBox[{"plotData", ",", "\n", "    ", 
       RowBox[{"Frame", " ", "->", " ", "True"}], ",", "\n", "    ", 
       RowBox[{"Axes", " ", "->", " ", "False"}], ",", "\n", "    ", 
       RowBox[{"PlotMarkers", " ", "->", " ", "plotMarkers"}], ",", "\n", 
       "    ", 
       RowBox[{"PlotStyle", " ", "->", " ", "plotStyles"}], ",", "\n", "    ", 
       RowBox[{"PlotLegends", " ", "->", " ", 
        RowBox[{"Placed", "[", 
         RowBox[{"plotLegends", ",", " ", "Above"}], "]"}]}], ",", "\n", 
       "    ", 
       RowBox[{"FrameLabel", " ", "->", " ", 
        RowBox[{"{", 
         RowBox[{"\"\<latent dimension z\>\"", ",", 
          " ", "\"\<performance score\>\"", ",", " ", "None", ",", "\n", 
          "      ", "\"\<correlation\>\""}], "}"}]}], ",", "\n", "    ", 
       RowBox[{"FrameTicks", " ", "->", " ", 
        RowBox[{"{", 
         RowBox[{
          RowBox[{"{", 
           RowBox[{"Automatic", ",", " ", "Automatic"}], "}"}], ",", " ", 
          RowBox[{"{", 
           RowBox[{
            RowBox[{"Thread", "[", 
             RowBox[{"{", 
              RowBox[{"allZDims", ",", " ", "allZDims"}], "}"}], "]"}], ",", 
            " ", "None"}], "}"}]}], "}"}]}], ",", "\n", "    ", 
       RowBox[{"PlotRange", " ", "->", " ", 
        RowBox[{"{", 
         RowBox[{
          RowBox[{"{", 
           RowBox[{
            RowBox[{
             RowBox[{"Min", "[", "allZDims", "]"}], " ", "-", " ", "1"}], ",",
             " ", 
            RowBox[{
             RowBox[{"Max", "[", "allZDims", "]"}], " ", "+", " ", "1"}]}], 
           "}"}], ",", " ", 
          RowBox[{"{", 
           RowBox[{
            RowBox[{"-", "0.05"}], ",", " ", "1.02"}], "}"}]}], "}"}]}], ",", 
       "\n", "    ", 
       RowBox[{"GridLines", " ", "->", " ", 
        RowBox[{"{", 
         RowBox[{"allZDims", ",", " ", "Automatic"}], "}"}]}], ",", "\n", 
       "    ", 
       RowBox[{"ImageSize", " ", "->", " ", "520"}], ",", "\n", "    ", 
       RowBox[{"PlotLabel", " ", "->", " ", "title"}]}], "\n", "  ", 
      "]"}]}]}], "\n", "]"}]}], "\n"}], "Input",
