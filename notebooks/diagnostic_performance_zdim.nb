Cell[BoxData[{
 RowBox[{
  RowBox[{
   RowBox[{"corrCPU", "[", "param_", "]"}], " ", ":=", " ", 
   RowBox[{
    RowBox[{"paramDataCPU", "[", "param", "]"}], "[", 
    RowBox[{"[", 
     RowBox[{"All", ",", " ", "1"}], "]"}], "]"}]}], ";"}], "\n", 
 RowBox[{
  RowBox[{
   RowBox[{
    RowBox[{"perfCPU", "[", "param_", "]"}], " ", ":=", " ", 
    RowBox[{"1", " ", "-", " ", 
     RowBox[{"(", 
      RowBox[{
       RowBox[{"(", 
        RowBox[{
         RowBox[{
          RowBox[{"paramDataCPU", "[", "param", "]"}], "[", 
          RowBox[{"[", 
           RowBox[{"All", ",", " ", "2"}], "]"}], "]"}], "/", "100"}], ")"}], 
       "/", "baselineError"}], ")"}]}]}], ";"}], "\n"}], "\n", 
 RowBox[{
  RowBox[{
   RowBox[{
    RowBox[{"cpuSeriesFor", "[", 
     RowBox[{"corrVals_", ",", " ", "perfVals_"}], "]"}], " ", ":=", " ", 
    RowBox[{"Module", "[", 
     RowBox[{
      RowBox[{"{", "param", "}"}], ",", "\n", "  ", 
      RowBox[{
       RowBox[{"param", " ", "=", " ", 
        RowBox[{"SelectFirst", "[", "\n", "    ", 
         RowBox[{
          RowBox[{"Keys", "[", "paramData", "]"}], ",", "\n", "    ", 
          RowBox[{
           RowBox[{
            RowBox[{
             RowBox[{"corr", "[", "#", "]"}], " ", "===", " ", "corrVals"}], 
            " ", "&&", " ", 
            RowBox[{
             RowBox[{"perf", "[", "#", "]"}], " ", "===", " ", "perfVals"}]}],
            " ", "&"}], ",", "\n", "    ", "None"}], "\n", "  ", "]"}]}], ";",
        "\n", "  ", 
       RowBox[{"If", "[", 
        RowBox[{
         RowBox[{"param", " ", "=!=", " ", "None"}], ",", "\n", "    ", 
         RowBox[{"{", 
          RowBox[{
           RowBox[{"corrCPU", "[", "param", "]"}], ",", " ", 
           RowBox[{"perfCPU", "[", "param", "]"}]}], "}"}], ",", "\n", "    ", 
         RowBox[{"If", "[", "\n", "      ", 
          RowBox[{
           RowBox[{
            RowBox[{"ValueQ", "[", "paramsNoSigma", "]"}], " ", "&&", " ", 
            RowBox[{"corrVals", " ", "===", " ", "meanCorrNoSigma"}], " ", "&&",
             "\n", "        ", 
            RowBox[{"perfVals", " ", "===", " ", "meanPerfNoSigma"}]}], ",", 
           "\n", "      ", 
           RowBox[{"{", "\n", "        ", 
            RowBox[{
             RowBox[{"Mean", " ", "/@", " ", 
              RowBox[{"Transpose", "[", 
               RowBox[{"corrCPU", " ", "/@", " ", "paramsNoSigma"}], "]"}]}], 
             ",", "\n", "        ", 
             RowBox[{"Mean", " ", "/@", " ", 
              RowBox[{"Transpose", "[", 
               RowBox[{"perfCPU", " ", "/@", " ", "paramsNoSigma"}], 
               "]"}]}]}], "\n", "      ", "}"}], ",", "\n", "      ", 
           RowBox[{"{", 
            RowBox[{
             RowBox[{"{", "}"}], ",", " ", 
             RowBox[{"{", "}"}]}], "}"}]}], "\n", "    ", "]"}]}], "\n", "  ",
         "]"}]}]}], "\n", "]"}]}], ";"}], "\n"}], "\n", 
 RowBox[{
