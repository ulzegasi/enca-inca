          RowBox[{"{", 
           RowBox[{"\"\<\[EmptySquare]\>\"", ",", " ", "16"}], "}"}]}], "}"}],
         ",", "\n", "    ", 
        RowBox[{"Length", "[", "plotData", "]"}]}], "\n", "  ", "]"}]}], ";", 
     "\n", "  ", 
     RowBox[{"plotLegends", " ", "=", " ", 
      RowBox[{"Take", "[", "\n", "    ", 
       RowBox[{
        RowBox[{"{", 
         RowBox[{"\"\<1 - (mean) normalized RMSE\>\"", ",", 
          " ", "\"\<mean corr\>\"", ",", "\n", 
          "     ", "\"\<CPU 1 - (mean) normalized RMSE\>\"", ",", 
          " ", "\"\<CPU mean corr\>\""}], "}"}], ",", "\n", "    ", 
        RowBox[{"Length", "[", "plotData", "]"}]}], "\n", "  ", "]"}]}], ";", 
     "\n", "  ", 
     RowBox[{"allZDims", " ", "=", " ", 
      RowBox[{"Sort", "[", 
       RowBox[{"Union", "[", 
        RowBox[{"zDims", ",", " ", 
         RowBox[{"If", "[", 
          RowBox[{
           RowBox[{"cpuCorrVals", " ", "===", " ", 
            RowBox[{"{", "}"}]}], ",", " ", 
           RowBox[{"{", "}"}], ",", " ", "zDimsCPU"}], "]"}]}], "]"}], 
       "]"}]}], ";", "\n", "  ", 
     RowBox[{"gridZDims", " ", "=", " ", 
      RowBox[{"Range", "[", 
       RowBox[{
        RowBox[{"Min", "[", "allZDims", "]"}], ",", " ", 
        RowBox[{"Max", "[", "allZDims", "]"}]}], "]"}]}], ";", "\n", "  ", 
     RowBox[{"ListLinePlot", "[", "\n", "    ", 
      RowBox[{"plotData", ",", "\n", "    ", 
       RowBox[{"Frame", " ", "->", " ", "True"}], ",", "\n", "    ", 
       RowBox[{"Axes", " ", "->", " ", "False"}], ",", "\n", "    ", 
       RowBox[{"PlotMarkers", " ", "->", " ", "plotMarkers"}], ",", "\n", 
