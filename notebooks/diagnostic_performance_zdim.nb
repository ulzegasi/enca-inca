          RowBox[{
           RowBox[{"{", 
            
            RowBox[{"\"\<1 - (mean) normalized RMSE\>\"", 
             ",", "\"\<mean corr\>\""}], "}"}], ",", "Above"}], "]"}]}], ",", 
        
        RowBox[{"FrameLabel", "->", 
