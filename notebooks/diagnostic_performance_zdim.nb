       "\n", "    ", 
       RowBox[{"GridLines", " ", "->", " ", 
        RowBox[{"{", 
         RowBox[{"gridZDims", ",", " ", "Automatic"}], "}"}]}], ",", "\n", 
       "    ", 
       RowBox[{"FrameStyle", " ", "->", " ", 
        RowBox[{"Directive", "[", 
         RowBox[{"Black", ",", " ", 
