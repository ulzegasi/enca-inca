        RowBox[{"{", "}"}], ",", " ", 
        RowBox[{"Transpose", "[", 
         RowBox[{"{", 
          RowBox[{"zDimsCPU", ",", " ", "cpuCorrVals"}], "}"}], "]"}]}], 
       "]"}]}], ";", "\n", "  ", 
     RowBox[{"plotData", " ", "=", " ", 
      RowBox[{"DeleteCases", "[", 
       RowBox[{
        RowBox[{"{", 
         RowBox[{
         "perfData", ",", " ", "corrData", ",", " ", "perfDataCPU", ",", " ", 
