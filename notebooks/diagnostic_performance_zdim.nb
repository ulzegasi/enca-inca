Cell[TextData[{
 StyleBox["Pooled reconstruction performance with run-to-run variability",
  FontWeight->"Bold"],
 "\nWe found no reason to treat CPU and GPU runs separately, and interpret \
their differences as part of training stochasticity. CPU and GPU trainings \
are treated as independent realizations of the same stochastic training \
procedure. Hardware-dependent numerical differences may change the \
optimization trajectory, but are not assumed to introduce a systematic \
performance bias; instead, they are included in the observed run-to-run \
variability.\n\nFor each latent dimension z, all available CPU and GPU runs \
are pooled. The plotted mean is the arithmetic mean of the reconstruction \
performance values at that z. The vertical error bar is the sample standard \
deviation across the available runs at that z. Latent dimensions with only \
one available run are not included in the pooled mean/error-bar layer, but \
their individual run is still shown as a faint point. Faint filled circles \
show the individual GPU runs, and faint open circles show the individual CPU \
runs."
}], "Text",
 Background->RGBColor[
  0.85, 0.92, 1, 0.45],ExpressionUUID->"f57ce8e9-22e4-4c19-9a77-2ad72fd1572f"],

Cell["Pooled mean with run-to-run variability:", "Text",
 FontWeight->"Bold",ExpressionUUID->"99a55080-cf8b-4c11-8a53-5825985da8f9"],

Cell[CellGroupData[{

Cell[BoxData[{
 RowBox[{
  RowBox[{
   RowBox[{"reconRunPairs", " ", "=", " ", 
    RowBox[{"Join", "[", "\n", "   ", 
     RowBox[{
      RowBox[{"Transpose", "[", 
       RowBox[{"{", 
        RowBox[{"zdim", ",", " ", "reconPerf"}], "}"}], "]"}], ",", "\n", 
      "   ", 
      RowBox[{"Transpose", "[", 
       RowBox[{"{", 
        RowBox[{"zdimCPU", ",", " ", "reconPerfCPU"}], "}"}], "]"}]}], "\n", 
     "   ", "]"}]}], ";"}], "\n"}], "\n", 
 RowBox[{
  RowBox[{
   RowBox[{"reconGroupedPairs", " ", "=", " ", 
    RowBox[{"Select", "[", 
     RowBox[{
      RowBox[{"GatherBy", "[", 
       RowBox[{
        RowBox[{"SortBy", "[", 
         RowBox[{"reconRunPairs", ",", " ", "First"}], "]"}], ",", " ", 
        "First"}], "]"}], ",", " ", 
      RowBox[{
       RowBox[{"Length", "[", "#", "]"}], " ", ">", " ", "1"}], " ", "&"}], 
     "]"}]}], ";"}], "\n"}], "\n", 
 RowBox[{
  RowBox[{
   RowBox[{"reconMeanSD", " ", "=", " ", 
    RowBox[{"(", 
     RowBox[{
      RowBox[{
       RowBox[{"{", 
        RowBox[{
         RowBox[{"#", "[", 
          RowBox[{"[", 
           RowBox[{"1", ",", " ", "1"}], "]"}], "]"}], ",", " ", 
         RowBox[{"Mean", "[", 
          RowBox[{"#", "[", 
           RowBox[{"[", 
            RowBox[{"All", ",", " ", "2"}], "]"}], "]"}], "]"}], ",", "\n", 
         "      ", 
         RowBox[{"If", "[", 
          RowBox[{
           RowBox[{
            RowBox[{"Length", "[", "#", "]"}], " ", ">", " ", "1"}], ",", " ", 
           RowBox[{"StandardDeviation", "[", 
            RowBox[{"#", "[", 
             RowBox[{"[", 
              RowBox[{"All", ",", " ", "2"}], "]"}], "]"}], "]"}], ",", " ", 
           "0"}], "]"}]}], "}"}], " ", "&"}], " ", "/@", " ", 
      "reconGroupedPairs"}], ")"}]}], ";"}], "\n"}], "\n", 
 RowBox[{
  RowBox[{
   RowBox[{"reconMeanPts", " ", "=", " ", 
    RowBox[{"reconMeanSD", "[", 
     RowBox[{"[", 
      RowBox[{"All", ",", " ", 
       RowBox[{"{", 
        RowBox[{"1", ",", " ", "2"}], "}"}]}], "]"}], "]"}]}], ";"}], 
  "\n"}], "\n", 
 RowBox[{
  RowBox[{
   RowBox[{"reconErrorBars", " ", "=", " ", 
    RowBox[{"Flatten", "[", "\n", "   ", 
     RowBox[{
      RowBox[{"(", 
       RowBox[{
        RowBox[{
         RowBox[{"{", 
          RowBox[{
           RowBox[{"Line", "[", 
            RowBox[{"{", 
             RowBox[{
              RowBox[{"{", 
               RowBox[{
                RowBox[{"#", "[", 
                 RowBox[{"[", "1", "]"}], "]"}], ",", " ", 
                RowBox[{
                 RowBox[{"#", "[", 
                  RowBox[{"[", "2", "]"}], "]"}], " ", "-", " ", 
                 RowBox[{"#", "[", 
                  RowBox[{"[", "3", "]"}], "]"}]}]}], "}"}], ",", " ", 
              RowBox[{"{", 
               RowBox[{
                RowBox[{"#", "[", 
                 RowBox[{"[", "1", "]"}], "]"}], ",", " ", 
                RowBox[{
                 RowBox[{"#", "[", 
                  RowBox[{"[", "2", "]"}], "]"}], " ", "+", " ", 
                 RowBox[{"#", "[", 
                  RowBox[{"[", "3", "]"}], "]"}]}]}], "}"}]}], "}"}], "]"}], ",",
            "\n", "       ", 
           RowBox[{"Line", "[", 
            RowBox[{"{", 
             RowBox[{
              RowBox[{"{", 
               RowBox[{
                RowBox[{
                 RowBox[{"#", "[", 
                  RowBox[{"[", "1", "]"}], "]"}], " ", "-", " ", "0.12"}], ",",
                 " ", 
                RowBox[{
                 RowBox[{"#", "[", 
                  RowBox[{"[", "2", "]"}], "]"}], " ", "-", " ", 
                 RowBox[{"#", "[", 
                  RowBox[{"[", "3", "]"}], "]"}]}]}], "}"}], ",", " ", 
              RowBox[{"{", 
               RowBox[{
                RowBox[{
                 RowBox[{"#", "[", 
                  RowBox[{"[", "1", "]"}], "]"}], " ", "+", " ", "0.12"}], ",",
                 " ", 
