Cell[BoxData[{
 RowBox[{
  RowBox[{
   RowBox[{
    RowBox[{"corr", "[", "param_", "]"}], ":=", 
    RowBox[{
     RowBox[{"paramData", "[", "param", "]"}], "[", 
     RowBox[{"[", 
      RowBox[{"All", ",", "1"}], "]"}], "]"}]}], ";"}], 
  "\[IndentingNewLine]"}], "\n", 
 RowBox[{
  RowBox[{"baselineError", "=", 
   RowBox[{"1", "/", 
    RowBox[{"Sqrt", "[", "12", "]"}]}]}], ";"}], "\[IndentingNewLine]", 
 RowBox[{
  RowBox[{
   RowBox[{"perf", "[", "param_", "]"}], ":=", 
   RowBox[{"1", "-", 
    RowBox[{
     RowBox[{"(", 
      RowBox[{
       RowBox[{
        RowBox[{"paramData", "[", "param", "]"}], "[", 
        RowBox[{"[", 
         RowBox[{"All", ",", "2"}], "]"}], "]"}], "/", "100"}], ")"}], "/", 
     "baselineError"}]}]}], ";"}]}], "Input",
 CellChangeTimes->{{3.986881243012053*^9, 3.986881255897674*^9}, {
   3.9868813760976763`*^9, 3.986881376665441*^9}, {3.9868822684827003`*^9, 
   3.986882273640232*^9}, {3.986882344006482*^9, 3.986882348877543*^9}, {
   3.986882587531798*^9, 3.9868825965923147`*^9}, {3.986883282983376*^9, 
   3.9868832865352573`*^9}, 3.986883502365691*^9},
 CellLabel->
  "In[158]:=",ExpressionUUID->"142b69f1-80ab-4de2-bb59-784a63a0510f"],

Cell[TextData[{
 StyleBox["-------------------------------------------------------------------\
---------------------------------------------------------\nPerformance score ",
  FontWeight->"Bold"],
 "\nFor each physical parameter, the diagnostic test reports \n",
 StyleBox["normalized RMSE=RMSE/prior range",
  FontColor->GrayLevel[0],
  Background->RGBColor[0.93, 0.27, 0.27, 0.33]],
 ".\nSince the parameters are sampled uniformly from their prior intervals, a \
trivial baseline predictor is one that always predicts the prior mean, i.e. \
the midpoint of the allowed interval.\nFor a uniform distribution on[a,b], \
the standard deviation is (b-a)/Sqrt[12].\nTherefore,the normalized RMSE of \
this trivial mean predictor is $\n\
baselineError=((b-a)/Sqrt[12])/(b-a)=1/Sqrt[12].\nWe define the ",
 StyleBox["baseline-corrected performance score ",
  FontWeight->"Bold"],
 "as \n",
 StyleBox["performance=1-normalizedRMSE/baselineError=1-(RMSE/prior \
range)/(1/Sqrt[12])",
  Background->RGBColor[0.93, 0.27, 0.27, 0.33]],
 ".\n\nInterpretation:\nperformance=1  --- perfect prediction,RMSE=0 \n\
performance=0  --- no better than always predicting the prior mean \n\
performance<0 ---  worse than the prior-mean predictor \n\nThus this score \
measures the fraction of the naive baseline error removed by the encoder.\n\
For example, performance=0.6 means that the model has reduced the RMSE by \
about 60% relative to always predicting the prior mean.\n",
 StyleBox["-------------------------------------------------------------------\
---------------------------------------------------------",
  FontWeight->"Bold"]
}], "Text",
 CellChangeTimes->{{3.986883421571703*^9, 3.9868835409336348`*^9}, {
  3.986883576744286*^9, 3.986883579652225*^9}, {3.98688361162658*^9, 
  3.9868836909092693`*^9}, {3.986885535489252*^9, 3.986885536316354*^9}},
 Background->RGBColor[
  1, 0.75, 0, 0.33],ExpressionUUID->"b74f71a8-e626-4a52-97b8-5b07f5688daa"],

