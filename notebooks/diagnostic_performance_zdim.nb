Cell[CellGroupData[{

Cell["Reconstruction", "Section",
 CellChangeTimes->{{3.986887723884878*^9, 
  3.986887759351733*^9}},ExpressionUUID->"c9954348-bd09-4a07-826a-\
d02dc71813b4"],

Cell["\<\
Parameters : tau = 5, T = 6, Nd = 12, sigma = 0.02, Bmax = 8
nseeds = 10\
\>", "Text",
 CellChangeTimes->{{3.9868878888099546`*^9, 
  3.986887911371634*^9}},ExpressionUUID->"084e32c8-9e2c-4dc7-a584-\
dc35d75de77f"],

Cell[TextData[{
 StyleBox["Reconstruction performance",
  FontWeight->"Bold"],
 "\nThe reconstruction tests are run with the same physical parameters and \
the same number of noise realizations for each latent dimension, so the \
reported mean_RMSE values from recon_test.py are directly comparable. Lower \
mean_RMSE means better reconstruction.\n\nTo plot a higher-is-better score, \
the RMSE values are normalized by the worst RMSE among the currently tested \
latent dimensions:\n\n",
 StyleBox["reconstruction performance = 1 - meanRMSE/rmseRef",
  Background->RGBColor[0.93, 0.27, 0.27, 0.33]],
 ",\n\nwhere rmseRef = Max[meanRMSE]. With this definition, performance = 1 \
would correspond to perfect reconstruction, while performance = 0 corresponds \
to the worst model in the current comparison set. For example, a value of \
0.47 means that the model reduces the reconstruction RMSE by about 47% \
relative to the current worst model."
}], "Text",
 CellChangeTimes->{{3.986889*^9, 3.98688862944072*^9}, 3.9868887138770447`*^9},
 Background->RGBColor[
  1, 0.75, 0, 0.33],ExpressionUUID->"0fb3589e-32fa-4b7d-aea5-4fd2e22556cc"],

Cell[BoxData[{
 RowBox[{
  RowBox[{"zdim", "=", 
   RowBox[{"{", 
    RowBox[{"6", ",", "8", ",", "10"}], "}"}]}], ";"}], "\[IndentingNewLine]", 
 RowBox[{
  RowBox[{"meanRMSE", "=", 
   RowBox[{"{", 
    RowBox[{"84.7185", ",", "45.0629", ",", "70.2793"}], "}"}]}], 
  ";"}]}], "Input",
 CellChangeTimes->{{3.986876765040416*^9, 3.986876908712228*^9}, {
   3.986887777395194*^9, 3.986887830660801*^9}, 3.9868879150730553`*^9, {
   3.986887968221195*^9, 3.986887970818446*^9}, 3.98688809758685*^9},
 CellLabel->
  "In[191]:=",ExpressionUUID->"3f65a06d-5508-4339-affb-300c9cdcc207"],

Cell[BoxData[{
 RowBox[{
  RowBox[{"rmseRef", "=", 
   RowBox[{"Max", "[", "meanRMSE", "]"}]}], ";"}], "\[IndentingNewLine]", 
 RowBox[{
  RowBox[{"reconPerf", "=", 
   RowBox[{"1", "-", 
    RowBox[{"meanRMSE", "/", "rmseRef"}]}]}], ";"}]}], "Input",
 CellChangeTimes->{{3.986888324966412*^9, 3.986888326305983*^9}},
