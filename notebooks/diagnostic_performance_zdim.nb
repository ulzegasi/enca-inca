       RowBox[{"PlotLegends", " ", "->", " ", 
        RowBox[{"Placed", "[", 
         RowBox[{"plotLegends", ",", " ", "Above"}], "]"}]}], ",", "\n", 
       "    ", 
       RowBox[{"FrameLabel", " ", "->", " ", 
        RowBox[{"{", 
         RowBox[{"\"\<latent dimension z\>\"", ",", 
          " ", "\"\<performance score\>\"", ",", " ", "None", ",", "\n", 
          "      ", "\"\<correlation\>\""}], "}"}]}], ",", "\n", "    ", 
       RowBox[{"FrameTicks", " ", "->", " ", 
        RowBox[{"{", 
         RowBox[{
          RowBox[{"{", 
           RowBox[{"Automatic", ",", " ", "Automatic"}], "}"}], ",", " ", 
          RowBox[{"{", 
           RowBox[{
            RowBox[{"Thread", "[", 
             RowBox[{"{", 
              RowBox[{"allZDims", ",", " ", "allZDims"}], "}"}], "]"}], ",", 
            " ", "None"}], "}"}]}], "}"}]}], ",", "\n", "    ", 
       RowBox[{"PlotRange", " ", "->", " ", 
        RowBox[{"{", 
         RowBox[{
          RowBox[{"{", 
           RowBox[{
            RowBox[{
             RowBox[{"Min", "[", "allZDims", "]"}], " ", "-", " ", "1"}], ",",
             " ", 
            RowBox[{
             RowBox[{"Max", "[", "allZDims", "]"}], " ", "+", " ", "1"}]}], 
