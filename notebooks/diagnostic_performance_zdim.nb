     "  ", 
     RowBox[{
      RowBox[{"{", 
       RowBox[{"cpuCorrVals", ",", " ", "cpuPerfVals"}], "}"}], " ", "=", " ", 
      RowBox[{"cpuSeriesFor", "[", 
       RowBox[{"corrVals", ",", " ", "perfVals"}], "]"}]}], ";", "\n", "  ", 
     RowBox[{"perfDataCPU", " ", "=", " ", 
      RowBox[{"If", "[", 
       RowBox[{
        RowBox[{"cpuPerfVals", " ", "===", " ", 
         RowBox[{"{", "}"}]}], ",", " ", 
        RowBox[{"{", "}"}], ",", " ", 
        RowBox[{"Transpose", "[", 
         RowBox[{"{", 
          RowBox[{"zDimsCPU", ",", " ", "cpuPerfVals"}], "}"}], "]"}]}], 
       "]"}]}], ";", "\n", "  ", 
     RowBox[{"corrDataCPU", " ", "=", " ", 
      RowBox[{"If", "[", 
